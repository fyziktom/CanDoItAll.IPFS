{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OperatingProfile": {
    "Mode": "Light"
  },
  "ControlAppSecurity": {
    "AdminAccessKey": "",
    "RemotePinAccessKey": "",
    "AdminPermitLimit": 60,
    "RemotePinPermitLimit": 12,
    "RateLimitWindowSeconds": 60
  },
  "RemotePinSecurity": {
    "CompatibilityModeEnabled": true,
    "RequestExpiryMinutes": 15,
    "AllowedClockSkewSeconds": 60,
    "LocalKeyId": "",
    "LocalSharedSecret": "",
    "TrustedSenders": []
  },
  "GatewayPublishing": {
    "ImmutableFileMaxAgeSeconds": 31536000,
    "MutableContentMaxAgeSeconds": 60
  },
  "NodeSettingsDefaults": {
    "Label": "Local IPFS node",
    "BaseUrl": "http://127.0.0.1:5001/",
    "ApiPath": "api/v0",
    "TimeoutSeconds": 120
  }
}
