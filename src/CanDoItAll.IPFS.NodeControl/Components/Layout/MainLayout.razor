@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject SideMenuService SideMenus
@inject NotificationService NotificationService
@inject LocalNodeBootstrapService LocalNodeBootstrapService
@inject NodeSessionState NodeSessionState
@inject NodeSettingsBrowserStorage NodeSettingsBrowserStorage
@inject ServerNodeSettingsStore ServerNodeSettingsStore
@inject RemotePinRequestStore RemotePinRequestStore
@inject Microsoft.Extensions.Options.IOptions<NodeConnectionSettings> DefaultNodeSettingsOptions
@inject ILogger<MainLayout> Logger

<ThemeHost ThemeKey="@CadThemes.Light">
    <Layout FitViewport="true"
            LockOverflow="true">
        <SideMenu MenuId="@MenuId"
                  Title="IPFS Node Control"
                  Subtitle="@NodeSessionState.CurrentSettings.Label"
                  Icon="hub"
                  AriaLabel="IPFS node navigation"
                  FillHeight="true"
                  Items="@NavigationItems"
                  BottomItems="@BottomNavigationItems"
                  ItemSelected="HandleMenuSelectionAsync" />

        <Body FillHeight="true"
              Scrollable="true">
            @Body
        </Body>
    </Layout>

    <DialogHost />
    <Tooltip />
    <Notification Position="NotificationPosition.TopRight" />
</ThemeHost>

@code {
    internal const string MenuId = "ipfs-node-control-primary-navigation";

    private int pendingRequestCount;

    private IReadOnlyList<ISideMenuItem> NavigationItems =>
    [
        new SideMenuItemDefinition
        {
            Id = "dashboard",
            Text = "Dashboard",
            Icon = "dashboard",
            Description = "Node health and the current connection.",
            Payload = "/dashboard",
            OverflowBehavior = SideMenuOverflowBehavior.PreferVisible
        },
        new SideMenuItemDefinition
        {
            Id = "files",
            Text = "Files",
            Icon = "folder",
            Description = "Browse and manage content on the current node.",
            Payload = "/files/explorer",
            OverflowBehavior = SideMenuOverflowBehavior.PreferVisible
        },
        new SideMenuItemDefinition
        {
            Id = "pin-requests",
            Text = "Pin requests",
            Icon = "move_to_inbox",
            Description = "Review incoming remote pin requests.",
            BadgeText = pendingRequestCount > 0 ? pendingRequestCount.ToString() : string.Empty,
            Payload = "/pin-requests",
            OverflowBehavior = SideMenuOverflowBehavior.PreferVisible
        },
        new SideMenuItemDefinition
        {
            Id = "logs",
            Text = "Logs",
            Icon = "notes",
            Description = "Inspect node and control-plane events.",
            Payload = "/logs"
        },
        new SideMenuItemDefinition
        {
            Id = "content",
            Text = "Content",
            Icon = "data_object",
            Description = "Run focused content workflows.",
            Payload = "/content"
        },
        new SideMenuItemDefinition
        {
            Id = "network",
            Text = "Network",
            Icon = "hub",
            Description = "Inspect peers, topology, and network state.",
            Payload = "/network"
        }
    ];

    private static readonly IReadOnlyList<ISideMenuItem> BottomNavigationItems =
    [
        new SideMenuItemDefinition
        {
            Id = "settings",
            Text = "Settings",
            Icon = "tune",
            Description = "Configure the current node connection.",
            Payload = "/settings"
        }
    ];

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        NodeSessionState.Changed += HandleNodeStateChanged;
        RemotePinRequestStore.RequestChanged += HandleRemotePinRequestChanged;
        pendingRequestCount = CountPendingRequests();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await SynchronizeMenuSelectionAsync();

        Logger.LogInformation("Main layout first render started bootstrap preparation for target {BaseUrl}.", NodeSessionState.CurrentSettings.BaseUrl);

        NodeConnectionSettings? savedSettings = null;
        try
        {
            savedSettings = await NodeSettingsBrowserStorage.LoadAsync();
            Logger.LogInformation("Loaded persisted node settings for target {BaseUrl}.", savedSettings?.BaseUrl ?? NodeSessionState.CurrentSettings.BaseUrl);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falling back to in-memory node settings because browser storage could not be read.");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Settings fallback in use",
                Detail = ex.Message
            });
        }

        NodeSessionState.Hydrate(savedSettings);
        Logger.LogInformation("Node session hydrated for target {BaseUrl}.", NodeSessionState.CurrentSettings.BaseUrl);

        try
        {
            await RecoverStartupTargetAsync();
            await LocalNodeBootstrapService.EnsureNodeForCurrentTargetAsync();
            Logger.LogInformation("Bootstrap check completed for target {BaseUrl}.", NodeSessionState.CurrentSettings.BaseUrl);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Local node bootstrap failed for target {BaseUrl}.", NodeSessionState.CurrentSettings.BaseUrl);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Local node startup skipped",
                Detail = ex.Message
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task HandleMenuSelectionAsync(SideMenuSelection selection)
    {
        if (selection.Source == SideMenuSelectionSource.External
            || selection.Item.Payload is not string route
            || IsActive(route))
        {
            return Task.CompletedTask;
        }

        NavigationManager.NavigateTo(route);
        return Task.CompletedTask;
    }

    private async Task SynchronizeMenuSelectionAsync()
    {
        var itemId = ResolveCurrentItemId();
        if (itemId == null
            || string.Equals(
                SideMenus.GetSnapshot(MenuId).SelectedItemId,
                itemId,
                StringComparison.Ordinal))
        {
            return;
        }

        await SideMenus.SelectAsync(MenuId, itemId, SideMenuSelectionSource.External);
    }

    private string? ResolveCurrentItemId()
    {
        var current = NormalizeLocation(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        if (string.IsNullOrEmpty(current) || IsRouteMatch(current, "dashboard"))
        {
            return "dashboard";
        }

        if (IsRouteMatch(current, "files") || IsRouteMatch(current, "files/explorer"))
        {
            return "files";
        }

        foreach (var item in NavigationItems.Concat(BottomNavigationItems))
        {
            if (item.Payload is string route && IsRouteMatch(current, route.Trim('/')))
            {
                return item.Id;
            }
        }

        return null;
    }

    private bool IsActive(string route)
    {
        var current = NormalizeLocation(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        var normalizedRoute = route.Trim('/');
        if (string.Equals(normalizedRoute, "files/explorer", StringComparison.OrdinalIgnoreCase)
            && IsRouteMatch(current, "files"))
        {
            return true;
        }

        return IsRouteMatch(current, normalizedRoute);
    }

    private static string NormalizeLocation(string location)
    {
        var queryIndex = location.IndexOfAny(['?', '#']);
        return (queryIndex >= 0 ? location[..queryIndex] : location).Trim('/');
    }

    private static bool IsRouteMatch(string current, string route)
        => string.Equals(current, route, StringComparison.OrdinalIgnoreCase)
            || current.StartsWith($"{route}/", StringComparison.OrdinalIgnoreCase);

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        try
        {
            await InvokeAsync(SynchronizeMenuSelectionAsync);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async void HandleNodeStateChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async void HandleRemotePinRequestChanged(StoredRemotePinRequest request)
    {
        try
        {
            await InvokeAsync(() =>
            {
                pendingRequestCount = CountPendingRequests();
                if (request.State == RemotePinRequestState.Pending)
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "Pin request received",
                        Detail = request.Request.Content.DisplayName
                    });
                }

                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private int CountPendingRequests()
        => RemotePinRequestStore.List().Count(request => request.State == RemotePinRequestState.Pending);

    private async Task RecoverStartupTargetAsync()
    {
        var preferredSettings = NodeSessionState.CurrentSettings;
        var resolvedSettings = await LocalNodeBootstrapService.ResolveStartupSettingsAsync(
            preferredSettings,
            DefaultNodeSettingsOptions.Value);
        if (AreEquivalent(preferredSettings, resolvedSettings))
        {
            return;
        }

        Logger.LogWarning(
            "Recovered startup node target from {PreviousBaseUrl} to {CurrentBaseUrl}.",
            preferredSettings.BaseUrl,
            resolvedSettings.BaseUrl);

        NodeSessionState.Update(resolvedSettings);
        try
        {
            ServerNodeSettingsStore.Save(resolvedSettings);
            await NodeSettingsBrowserStorage.SaveAsync(resolvedSettings);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "Recovered startup node target to {BaseUrl}, but persisting the repaired settings failed.",
                resolvedSettings.BaseUrl);
        }

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Warning,
            Summary = "Recovered local node target",
            Detail = $"{preferredSettings.BaseUrl} did not answer the startup probe, so the app switched to {resolvedSettings.BaseUrl}."
        });
    }

    private static bool AreEquivalent(NodeConnectionSettings left, NodeConnectionSettings right)
    {
        ArgumentNullException.ThrowIfNull(left);
        ArgumentNullException.ThrowIfNull(right);

        var normalizedLeft = left.Clone().Normalize();
        var normalizedRight = right.Clone().Normalize();
        return string.Equals(normalizedLeft.Label, normalizedRight.Label, StringComparison.Ordinal)
            && string.Equals(normalizedLeft.BaseUrl, normalizedRight.BaseUrl, StringComparison.OrdinalIgnoreCase)
            && string.Equals(normalizedLeft.ApiPath, normalizedRight.ApiPath, StringComparison.OrdinalIgnoreCase)
            && normalizedLeft.TimeoutSeconds == normalizedRight.TimeoutSeconds;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        NodeSessionState.Changed -= HandleNodeStateChanged;
        RemotePinRequestStore.RequestChanged -= HandleRemotePinRequestChanged;
    }
}
