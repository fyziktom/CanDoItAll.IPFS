@switch (Icon)
{
    case "Folder":
        <svg class="@BuildClass()" viewBox="0 0 24 24" fill="currentColor" aria-hidden="@AriaHidden.ToString().ToLowerInvariant()">
            <path d="M10 4l2 2h8c1.1 0 2 .9 2 2v8.5A3.5 3.5 0 0 1 18.5 20h-13A3.5 3.5 0 0 1 2 16.5v-9A3.5 3.5 0 0 1 5.5 4H10Z" />
        </svg>
        break;
    case "File":
        <svg class="@BuildClass()" viewBox="0 0 24 24" fill="currentColor" aria-hidden="@AriaHidden.ToString().ToLowerInvariant()">
            <path d="M14 2H7a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8l-6-6Zm0 2.8L17.2 8H14V4.8ZM8 12h8v1.8H8V12Zm0 3.8h8v1.8H8v-1.8Z" />
        </svg>
        break;
    case "Copy":
        <svg class="@BuildClass()" viewBox="0 0 24 24" fill="currentColor" aria-hidden="@AriaHidden.ToString().ToLowerInvariant()">
            <path d="M16 1a3 3 0 0 1 3 3v10h-2V4a1 1 0 0 0-1-1H7V1h9Zm-9 4h8a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1H7Z" />
        </svg>
        break;
    case "Upload":
        <svg class="@BuildClass()" viewBox="0 0 24 24" fill="currentColor" aria-hidden="@AriaHidden.ToString().ToLowerInvariant()">
            <path d="M14 2H7a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8l-6-6Zm0 2.8L17.2 8H14V4.8ZM12 18l-4-4h2.6v-3.5h2.8V14H16l-4 4Z" />
        </svg>
        break;
}

@code {
    [Parameter]
    public string Icon { get; set; } = "File";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool AriaHidden { get; set; } = true;

    private string BuildClass()
        => string.IsNullOrWhiteSpace(Class)
            ? "fx-icon"
            : $"fx-icon {Class}";
}
