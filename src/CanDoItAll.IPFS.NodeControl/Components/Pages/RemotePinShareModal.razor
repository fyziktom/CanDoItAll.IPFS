@using System.Globalization
@using System.IO
@inject IJSRuntime JSRuntime
@inject KnownRemotePinTargetBrowserStorage KnownRemotePinTargetBrowserStorage
@inject NotificationService NotificationService
@inject RemotePinShareService RemotePinShareService

@if (TargetItem is not null)
{
    <Dialog IsOpen="true"
            Eyebrow="Share"
            Title="@($"Pin {TargetItem.DisplayName} on another node")"
            Subtitle="Choose a receiver, probe the control app, then send a live request or export the same request for offline delivery."
            Size="@(ModalSize.Wide)"
            OnClose="CloseAsync">
        <ChildContent>
            <Stack Gap="1rem">
                <div class="rps-stepper" aria-label="Share steps">
                    <div class="rps-step @(GetStepCssClass(1))">
                        <span>1</span>
                        <strong>Choose receiver</strong>
                    </div>
                    <div class="rps-step @(GetStepCssClass(2))">
                        <span>2</span>
                        <strong>Probe</strong>
                    </div>
                    <div class="rps-step @(GetStepCssClass(3))">
                        <span>3</span>
                        <strong>Note and send</strong>
                    </div>
                </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <Alert AlertStyle="@(AlertStyle.Warning)">@errorMessage</Alert>
            }

            @if (!string.IsNullOrWhiteSpace(resultMessage))
            {
                <Alert AlertStyle="@(ResolveResultAlertStyle())">
                    <strong>@GetResultTitle()</strong>
                    <p>@resultMessage</p>
                </Alert>
            }

            @if (shareStep == 1)
            {
                <Stack Gap="1rem">
                    <CompactStatStrip>
                        <CompactStat Label="content"
                                     Value="@Shorten(TargetItem.DisplayName, 24)"
                                     TooltipText="@TargetItem.DisplayName"
                                     Tone="info" />
                        <CompactStat Label="type"
                                     Value="@(TargetItem.IsDirectory ? "Folder root" : "File")"
                                     TooltipText="Current share payload type."
                                     Tone="success" />
                        <CompactStat Label="cid"
                                     Value="@Shorten(TargetItem.Target, 24)"
                                     TooltipText="@TargetItem.Target"
                                     Tone="warning" />
                    </CompactStatStrip>

                    @if (!hasLoadedKnownTargets)
                    {
                        <LoadingState Eyebrow="Receivers"
                                      Title="Loading saved receivers"
                                      Description="Saved control-app targets are loading from this browser profile." />
                    }
                    else if (knownTargets.Count == 0)
                    {
                        <EmptyState Eyebrow="Receivers"
                                    Title="No saved receivers yet"
                                    Description="Add a control-app URL below. The sender app will reuse it as a selectable card next time." />
                    }
                    else
                    {
                        <div class="rps-card-grid">
                            @foreach (var target in knownTargets)
                            {
                                <button type="button"
                                        class="rps-target-card @(IsSelectedTarget(target) ? "is-selected" : string.Empty)"
                                        @onclick="@(() => SelectTarget(target.Id))">
                                    <strong>@target.Label</strong>
                                    <span>@target.ControlAppUrl</span>
                                    @if (!string.IsNullOrWhiteSpace(target.LastKnownNodeLabel))
                                    {
                                        <small>Last node: @target.LastKnownNodeLabel</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(target.LastFailureMessage))
                                    {
                                        <small>Last issue: @target.LastFailureMessage</small>
                                    }
                                </button>
                            }
                        </div>
                    }

                    <Row Gap="1rem" class="rps-add-grid">
                        <Column Size="12" SizeXL="6">
                            <FormField Text="Receiver label">
                                <TextBox Value="@newTargetLabel"
                                         ValueChanged="HandleNewTargetLabelChanged"
                                         Placeholder="Backup node"
                                         Immediate="true"
                                         Disabled="@isBusy" />
                            </FormField>
                        </Column>
                        <Column Size="12" SizeXL="6">
                            <FormField Text="Control-app URL">
                                <TextBox Value="@newTargetUrl"
                                         ValueChanged="HandleNewTargetUrlChanged"
                                         Placeholder="http://192.168.1.55:5092/"
                                         Immediate="true"
                                         Disabled="@isBusy" />
                            </FormField>
                        </Column>
                    </Row>

                    <Stack Orientation="Orientation.Horizontal"
                           Wrap="FlexWrap.Wrap"
                           Gap="0.75rem"
                           class="rps-actions">
                        <Button Text="Add receiver"
                                ButtonStyle="@(ButtonStyle.Light)"
                                Variant="@(Variant.Outlined)"
                                Click="AddKnownTargetAsync"
                                Disabled="@isBusy" />
                        <Button Text="Continue to probe"
                                Click="BeginProbeAsync"
                                Disabled="@(isBusy || SelectedTarget is null)" />
                    </Stack>
                </Stack>
            }
            else if (shareStep == 2)
            {
                <Stack Gap="1rem">
                    @if (isBusy)
                    {
                        <LoadingState Eyebrow="Probe"
                                      Title="Probing receiver"
                                      Description="Checking that the remote control app responds and the receiver node can report a healthy identity." />
                    }
                    else if (probeSnapshot is not null && probeSnapshot.NodeHealthy)
                    {
                        <Alert AlertStyle="@(AlertStyle.Success)">
                            <strong>Receiver is reachable</strong>
                            <p>@(SelectedTarget?.Label ?? "Receiver") responded and reported a healthy node. You can continue to the note step now.</p>
                        </Alert>

                        <CompactStatStrip>
                            <CompactStat Label="receiver"
                                         Value="@probeSnapshot.NodeLabel"
                                         TooltipText="Healthy node label reported by the receiver."
                                         Tone="success" />
                            <CompactStat Label="peer"
                                         Value="@Shorten(probeSnapshot.PeerId, 24)"
                                         TooltipText="@probeSnapshot.PeerId"
                                         Tone="info" />
                            <CompactStat Label="node api"
                                         Value="@Shorten(probeSnapshot.NodeBaseUrl, 24)"
                                         TooltipText="@probeSnapshot.NodeBaseUrl"
                                         Tone="warning" />
                            <CompactStat Label="control app"
                                         Value="@Shorten(probeSnapshot.ControlAppUrl, 24)"
                                         TooltipText="@probeSnapshot.ControlAppUrl"
                                         Tone="neutral" />
                        </CompactStatStrip>

                        <Stack Orientation="Orientation.Horizontal"
                               Wrap="FlexWrap.Wrap"
                               Gap="0.75rem"
                               class="rps-actions">
                            <Button Text="Back"
                                    ButtonStyle="@(ButtonStyle.Light)"
                                    Variant="@(Variant.Outlined)"
                                    Click="BackToSelection" />
                            <Button Text="Continue" Click="ContinueToCompose" />
                        </Stack>
                    }
                    else
                    {
                        <Alert AlertStyle="@(AlertStyle.Danger)">
                            <strong>Probe failed</strong>
                            <p>The selected control app did not return a healthy receiver response. Review the address and try again.</p>
                        </Alert>

                        <Stack Orientation="Orientation.Horizontal"
                               Wrap="FlexWrap.Wrap"
                               Gap="0.75rem"
                               class="rps-actions">
                            <Button Text="Back"
                                    ButtonStyle="@(ButtonStyle.Light)"
                                    Variant="@(Variant.Outlined)"
                                    Click="BackToSelection" />
                        </Stack>
                    }
                </Stack>
            }
            else
            {
                <Stack Gap="1rem">
                    <CompactStatStrip>
                        <CompactStat Label="receiver"
                                     Value="@(probeSnapshot?.NodeLabel ?? SelectedTarget?.Label ?? "Receiver")"
                                     TooltipText="Selected remote node for this request."
                                     Tone="success" />
                        <CompactStat Label="control app"
                                     Value="@Shorten(SelectedTarget?.ControlAppUrl ?? string.Empty, 24)"
                                     TooltipText="@(SelectedTarget?.ControlAppUrl ?? string.Empty)"
                                     Tone="info" />
                        <CompactStat Label="content"
                                     Value="@Shorten(TargetItem.DisplayName, 24)"
                                     TooltipText="@TargetItem.DisplayName"
                                     Tone="warning" />
                        <CompactStat Label="payload"
                                     Value="@GetContentSummary(TargetItem)"
                                     TooltipText="Size or visible direct item count."
                                     Tone="neutral" />
                    </CompactStatStrip>

                    <Alert AlertStyle="@(ResolveOutgoingSecurityAlertStyle())">
                        <strong>@outgoingSecurity.Summary</strong>
                        <p>@outgoingSecurity.Detail</p>
                    </Alert>

                    <FormField Text="Note for the receiver">
                        <TextArea Value="@noteText"
                                  ValueChanged="HandleNoteTextChanged"
                                  Rows="5"
                                  Placeholder="Explain why this node should pin the file or folder."
                                  Immediate="true"
                                  Disabled="@isBusy" />
                    </FormField>

                    <Stack Orientation="Orientation.Horizontal"
                           Wrap="FlexWrap.Wrap"
                           Gap="0.75rem"
                           class="rps-actions">
                        <Button Text="Back"
                                ButtonStyle="@(ButtonStyle.Light)"
                                Variant="@(Variant.Outlined)"
                                Click="BackToProbe"
                                Disabled="@isBusy" />
                        <Button Text="Send live request"
                                Click="SendLiveRequestAsync"
                                Disabled="@(isBusy || SelectedTarget is null || !outgoingSecurity.CanCreateRequests)" />
                        <Button Text="Export request"
                                ButtonStyle="@(ButtonStyle.Light)"
                                Variant="@(Variant.Outlined)"
                                Click="ExportOfflineAsync"
                                Disabled="@(isBusy || !outgoingSecurity.CanCreateRequests)" />
                    </Stack>
                </Stack>
            }
            </Stack>
        </ChildContent>
    </Dialog>
}

