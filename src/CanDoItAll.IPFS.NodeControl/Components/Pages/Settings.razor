@page "/settings"
@implements IDisposable
@inject NodeSessionState NodeSessionState
@inject NodeSettingsBrowserStorage NodeSettingsBrowserStorage
@inject ServerNodeSettingsStore ServerNodeSettingsStore
@inject NodeDashboardService NodeDashboardService
@inject INodeMaintenanceWorkflow MaintenanceWorkflow
@inject NotificationService NotificationService

<PageTitle>Settings</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Endpoint and maintenance"
                    Title="Settings"
                    Description="Endpoint, config, and maintenance controls."
                    Compact="true">
            <Stats>
                <CompactStat Label="target"
                             Value="@Shorten(editModel.BaseUrl, 24)"
                             TooltipText="@editModel.BaseUrl"
                             Tone="info" />
                <CompactStat Label="api path"
                             Value="@editModel.ApiPath"
                             Tone="neutral" />
                <CompactStat Label="timeout"
                             Value="@($"{editModel.TimeoutSeconds}s")"
                             Tone="warning" />
                <CompactStat Text="@maintenanceCapability.Status"
                             TooltipText="@maintenanceCapability.Detail"
                             Tone="@maintenanceCapability.Tone" />
            </Stats>
            <Actions>
                <Button Text="Save settings" Click="SaveSettingsAsync" />
                <Button Text="Test connection"
                        ButtonStyle="@(ButtonStyle.Light)"
                        Variant="@(Variant.Outlined)"
                        Click="TestConnectionAsync" />
                <HelpPopover AriaLabel="Show settings help"
                             Heading="Settings"
                             Body="Use tabs to switch between endpoint settings, direct config edits, and maintenance actions without keeping all of them on screen at once."
                             Tip="Settings are stored locally in the browser and applied to the scoped node session.">
                    <PanelContent>
                        <Stack GapScale="LayoutGap.Medium">
                            <Stack GapScale="LayoutGap.Small">
                                <StatusBadge Text="Local storage" Tone="info" />
                                <p>Saving updates both the live session state and the browser copy loaded during startup.</p>
                            </Stack>

                            <Stack GapScale="LayoutGap.Small">
                                <StatusBadge Text="@maintenanceCapability.Status" Tone="@maintenanceCapability.Tone" />
                                <p>@maintenanceCapability.Detail</p>
                                <p>Shutdown terminates the current node process exposed by the API endpoint.</p>
                            </Stack>
                        </Stack>
                    </PanelContent>
                </HelpPopover>
            </Actions>
        </PageHeader>
    </Header>

    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <Alert AlertStyle="@(AlertStyle.Warning)">@errorMessage</Alert>
        }

        @if (!string.IsNullOrWhiteSpace(connectionMessage))
        {
            <Alert AlertStyle="@(AlertStyle.Info)">@connectionMessage</Alert>
        }

        <Tabs SelectedIndex="@settingsTabIndex"
              SelectedIndexChanged="HandleSettingsTabChanged"
              Variant="@(TabsVariant.WorkspacePrimary)"
              BorderMode="@(TabsBorderMode.Soft)"
              Tone="@(TabsTone.Secondary)"
              OverflowMode="@(TabsOverflowMode.Scroll)"
              PanelOverflowMode="@(TabsPanelOverflowMode.Auto)"
              AriaLabel="Settings tabs">
            <TabItems>
                <TabsItem Text="Endpoint"
                          Icon="lan">
                    <Grid Gap="LayoutGap.Medium"
                          ColumnTemplateXl="minmax(0,1.45fr) minmax(24rem,0.7fr)">
                            <FormSection Title="Node endpoint" Description="Change the target node and save the values for future sessions.">
                                <Grid Gap="LayoutGap.Medium"
                                      ColumnTemplate="repeat(auto-fit,minmax(min(100%,18rem),1fr))">
                                    <FormField Text="Label">
                                        <TextBox Value="@editModel.Label"
                                                 ValueChanged="HandleLabelChanged"
                                                 Placeholder="Local IPFS node"
                                                 Disabled="@isBusy" />
                                    </FormField>

                                    <FormField Text="Base URL">
                                        <TextBox Value="@editModel.BaseUrl"
                                                 ValueChanged="HandleBaseUrlChanged"
                                                 Placeholder="http://127.0.0.1:5001/"
                                                 Disabled="@isBusy" />
                                    </FormField>

                                    <FormField Text="API path">
                                        <TextBox Value="@editModel.ApiPath"
                                                 ValueChanged="HandleApiPathChanged"
                                                 Placeholder="api/v0"
                                                 Disabled="@isBusy" />
                                    </FormField>

                                    <FormField Text="Timeout (seconds)">
                                        <Numeric TValue="int"
                                                 Value="@editModel.TimeoutSeconds"
                                                 ValueChanged="HandleTimeoutChanged"
                                                 Min="5"
                                                 Max="600"
                                                 Step="5"
                                                 Disabled="@isBusy" />
                                    </FormField>
                                </Grid>

                                <InlineActions>
                                    <Button Text="Reset local copy"
                                            ButtonStyle="@(ButtonStyle.Light)"
                                            Variant="@(Variant.Outlined)"
                                            Click="ResetSettingsAsync"
                                            Disabled="@isBusy" />
                                </InlineActions>
                            </FormSection>

                            <Stack Gap="1rem">
                                <SectionCard Title="Session copy" Description="The browser copy hydrates this shell on startup.">
                                    <CompactStatStrip>
                                        <CompactStat Label="target"
                                                     Value="@Shorten(editModel.BaseUrl, 18)"
                                                     TooltipText="@editModel.BaseUrl"
                                                     Tone="info" />
                                        <CompactStat Label="timeout"
                                                     Value="@($"{editModel.TimeoutSeconds}s")"
                                                     Tone="warning" />
                                    </CompactStatStrip>
                                </SectionCard>

                                <SectionCard Title="Maintenance posture" Description="@maintenanceCapability.Detail">
                                    <Stack Gap="0.75rem">
                                        <StatusBadge Text="@maintenanceCapability.Status" Tone="@maintenanceCapability.Tone" />
                                        <InlineActions>
                                            <Button Text="Config"
                                                    ButtonStyle="@(ButtonStyle.Light)"
                                                    Variant="@(Variant.Outlined)"
                                                    Click="@(() => HandleSettingsTabChanged(1))" />
                                            <Button Text="Maintenance"
                                                    ButtonStyle="@(ButtonStyle.Light)"
                                                    Variant="@(Variant.Outlined)"
                                                    Click="@(() => HandleSettingsTabChanged(2))" />
                                        </InlineActions>
                                    </Stack>
                                </SectionCard>
                            </Stack>
                    </Grid>
                </TabsItem>

                <TabsItem Text="Config"
                          Icon="tune">
                    <SectionCard Title="Config read and write" Description="Inspect the full config, query individual keys, or set values directly through config routes.">
                        <FormStack>
                            <FormRow Split="true">
                                <FormField Text="Config key">
                                    <TextBox Value="@configKey"
                                             ValueChanged="HandleConfigKeyChanged"
                                             Placeholder="Addresses.API"
                                             Disabled="@isBusy" />
                                </FormField>

                                <FormField Text="JSON mode">
                                    <SettingsSwitchRow>
                                        <TextBlock TextStyle="@(TextStyle.Caption)" Value="Parse the value as JSON before writing it back to the node." />
                                        <CheckBox TValue="bool" Value="@configTreatValueAsJson" ValueChanged="HandleConfigTreatValueAsJsonChanged" />
                                    </SettingsSwitchRow>
                                </FormField>
                            </FormRow>

                            <FormField Text="Config value">
                                <TextArea Value="@configValue"
                                          ValueChanged="HandleConfigValueChanged"
                                          Rows="6"
                                          Placeholder="@configValuePlaceholder"
                                          Disabled="@isBusy" />
                            </FormField>

                            <InlineActions>
                                <Button Text="Get key" Click="LoadConfigValueAsync" Disabled="@isBusy" />
                                <Button Text="Set key"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="SaveConfigValueAsync"
                                        Disabled="@isBusy" />
                                <Button Text="Load full config"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="LoadFullConfigAsync"
                                        Disabled="@isBusy" />
                            </InlineActions>

                            @if (!string.IsNullOrWhiteSpace(fullConfig))
                            {
                                <pre class="node-code-block">@fullConfig</pre>
                            }
                        </FormStack>
                    </SectionCard>
                </TabsItem>

                <TabsItem Text="Maintenance"
                          Icon="build_circle">
                    <SectionCard Title="Repo and node maintenance" Description="Operational actions that change node state.">
                        <FormStack>
                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Text="@maintenanceCapability.Status" Tone="@maintenanceCapability.Tone" />
                                <StatusBadge Text="Shutdown node" Tone="danger" />
                            </Cluster>

                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="@maintenanceCapability.Detail" />

                            <InlineActions>
                                <Button Text="Repo version" Click="LoadRepoVersionAsync" Disabled="@isBusy" />
                                <Button Text="Run repo gc"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="RunRepoGcAsync"
                                        Disabled="@isBusy" />
                                <Button Text="Shutdown node"
                                        ButtonStyle="@(ButtonStyle.Danger)"
                                        Variant="@(Variant.Text)"
                                        Click="ShutdownNodeAsync"
                                        Disabled="@isBusy" />
                            </InlineActions>

                            <Alert AlertStyle="@(AlertStyle.Info)">
                                Repo verify is intentionally omitted here because the current engine HTTP surface still returns HTTP 501 for verify requests.
                            </Alert>

                            @if (!string.IsNullOrWhiteSpace(repoVersion))
                            {
                                <Alert AlertStyle="@(AlertStyle.Info)">Repository version: @repoVersion</Alert>
                            }
                        </FormStack>
                    </SectionCard>
                </TabsItem>
            </TabItems>
        </Tabs>
    </ChildContent>
</PageScaffold>

