@page "/"
@page "/dashboard"
@implements IDisposable
@inject NodeDashboardService NodeDashboardService
@inject NodeSessionState NodeSessionState
@inject NotificationService NotificationService
@inject ILogger<Home> Logger

<PageTitle>Dashboard</PageTitle>

<PageScaffold MaxWidthClass="max-w-full">
    <Header>
        <PageHeader Eyebrow="Dashboard"
                    Title="Node overview"
                    Description="Live health, storage, traffic, and peer activity for the selected node."
                    Compact="true">
            <Stats>
                @if (summary is not null)
                {
                    <CompactStat Label="peer"
                                 Value="@Shorten(summary.PeerId, 18)"
                                 TooltipText="@summary.PeerId"
                                 Tone="info" />
                    <CompactStat Label="Active peers"
                                 Value="@summary.ConnectedPeerCount.ToString("n0")"
                                 TooltipText="Connected swarm peers"
                                 Tone="success" />
                    <CompactStat Label="stored"
                                 Value="@FormatBytes(summary.RepoSizeBytes)"
                                 TooltipText="Repository size"
                                 Tone="warning" />
                    <CompactStat Label="Pinned CIDs"
                                 Value="@summary.PinnedCidCount.ToString("n0")"
                                 TooltipText="Pinned content identifiers"
                                 Tone="neutral" />
                }
                else
                {
                    <CompactStat Text="summary loading" Tone="info" />
                    <CompactStat Text="@NodeSessionState.CurrentSettings.Label" Tone="neutral" />
                }
            </Stats>
            <Actions>
                <Button Text="Refresh" Click="LoadAsync" Disabled="@isLoading" />
                <Button Text="Files"
                        Href="/files"
                        ButtonStyle="@(ButtonStyle.Light)"
                        Variant="@(Variant.Outlined)" />
                <Button Text="Network"
                        Href="/network"
                        ButtonStyle="@(ButtonStyle.Light)"
                        Variant="@(Variant.Outlined)" />
                <Button Text="Settings"
                        Href="/settings"
                        ButtonStyle="@(ButtonStyle.Light)"
                        Variant="@(Variant.Outlined)" />
            </Actions>
        </PageHeader>
    </Header>
    <ChildContent>
        @if (isLoading && summary is null)
        {
            <LoadingState Eyebrow="Dashboard" Title="Loading node summary" Description="Collecting the latest node health snapshot from the selected endpoint." />
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <Alert AlertStyle="@(AlertStyle.Warning)">@errorMessage</Alert>
        }

        @if (summary is not null)
        {
            <Stack Gap="1rem">
                <Grid Gap="LayoutGap.Medium"
                      ColumnTemplateXl="minmax(0,1.1fr) minmax(0,1fr) minmax(0,1fr)">
                    <SectionCard Title="Node identity" Description="Peer identity, software versions, and advertised addresses.">
                        <Stack GapScale="LayoutGap.Medium">
                            <CompactStatStrip>
                                <CompactStat Label="peer"
                                             Value="@Shorten(summary.PeerId, 24)"
                                             TooltipText="@summary.PeerId"
                                             Tone="info" />
                                <CompactStat Label="agent"
                                             Value="@summary.AgentVersion"
                                             Tone="success" />
                                <CompactStat Label="protocol"
                                             Value="@summary.ProtocolVersion"
                                             Tone="warning" />
                                <CompactStat Label="api"
                                             Value="@summary.ApiVersion"
                                             Tone="neutral" />
                            </CompactStatStrip>

                            <Cluster Gap="LayoutGap.Small">
                                <StatusBadge Text="@($"{summary.Addresses.Count:n0} advertised address{(summary.Addresses.Count == 1 ? string.Empty : "es")}")" Tone="neutral" />
                                <StatusBadge Text="@($"Snapshot {FormatTimestamp(summary.SnapshotUtc)}")" Tone="info" />
                            </Cluster>

                            @if (summary.Addresses.Count > 0)
                            {
                                <div class="node-chip-flow">
                                    @foreach (var address in summary.Addresses.Take(4))
                                    {
                                        <StatusBadge Text="@Shorten(address, 42)" Tone="neutral" />
                                    }
                                    @if (summary.Addresses.Count > 4)
                                    {
                                        <StatusBadge Text="@($"{summary.Addresses.Count - 4:n0} more")" Tone="info" />
                                    }
                                </div>
                            }
                        </Stack>
                    </SectionCard>

                    <SectionCard Title="Storage" Description="Repository size, object count, capacity, and pinned content.">
                        <CompactStatStrip>
                            <CompactStat Label="Amount stored"
                                         Value="@FormatBytes(summary.RepoSizeBytes)"
                                         Tone="warning" />
                            <CompactStat Label="objects"
                                         Value="@summary.RepoObjectCount.ToString("n0")"
                                         Tone="success" />
                            <CompactStat Label="Pinned CIDs"
                                         Value="@summary.PinnedCidCount.ToString("n0")"
                                         Tone="info" />
                            <CompactStat Label="storage used"
                                         Value="@FormatStorageUsage(summary)"
                                         TooltipText="@($"Limit {FormatBytes(summary.RepoStorageMaxBytes)}")"
                                         Tone="neutral" />
                            <CompactStat Label="repo version"
                                         Value="@summary.RepoVersion"
                                         Tone="neutral" />
                            <CompactStat Label="path"
                                         Value="@Shorten(summary.RepoPath, 24)"
                                         TooltipText="@summary.RepoPath"
                                         Tone="neutral" />
                        </CompactStatStrip>
                    </SectionCard>

                    <SectionCard Title="Network activity" Description="Swarm, bootstrap, address filter, and PubSub counts.">
                        <CompactStatStrip>
                            <CompactStat Label="Active peers"
                                         Value="@summary.ConnectedPeerCount.ToString("n0")"
                                         Tone="success" />
                            <CompactStat Label="known peers"
                                         Value="@summary.KnownPeerCount.ToString("n0")"
                                         Tone="info" />
                            <CompactStat Label="bootstrap"
                                         Value="@summary.BootstrapPeerCount.ToString("n0")"
                                         Tone="warning" />
                            <CompactStat Label="filters"
                                         Value="@summary.AddressFilterCount.ToString("n0")"
                                         Tone="neutral" />
                            <CompactStat Label="PubSub topics"
                                         Value="@summary.PubSubTopicCount.ToString("n0")"
                                         Tone="neutral" />
                            <CompactStat Label="bitswap peers"
                                         Value="@summary.BitswapPeerCount.ToString("n0")"
                                         Tone="info" />
                        </CompactStatStrip>
                    </SectionCard>
                </Grid>

                <Grid Gap="LayoutGap.Medium"
                      ColumnTemplateXl="minmax(0,1fr) minmax(0,1fr)">
                    <SectionCard Title="Data transfer" Description="Bandwidth totals, live rates, and bitswap exchange counters.">
                        <CompactStatStrip>
                            <CompactStat Label="total in"
                                         Value="@FormatBytes(summary.TotalInBytes)"
                                         Tone="info" />
                            <CompactStat Label="total out"
                                         Value="@FormatBytes(summary.TotalOutBytes)"
                                         Tone="neutral" />
                            <CompactStat Label="rate in"
                                         Value="@FormatRate(summary.RateIn)"
                                         Tone="success" />
                            <CompactStat Label="rate out"
                                         Value="@FormatRate(summary.RateOut)"
                                         Tone="warning" />
                            <CompactStat Label="blocks in"
                                         Value="@summary.BitswapBlocksReceived.ToString("n0")"
                                         Tone="info" />
                            <CompactStat Label="blocks out"
                                         Value="@summary.BitswapBlocksSent.ToString("n0")"
                                         Tone="neutral" />
                            <CompactStat Label="bitswap in"
                                         Value="@FormatBytes(summary.BitswapDataReceivedBytes)"
                                         Tone="success" />
                            <CompactStat Label="bitswap out"
                                         Value="@FormatBytes(summary.BitswapDataSentBytes)"
                                         Tone="warning" />
                            <CompactStat Label="wantlist"
                                         Value="@summary.BitswapWantlistCount.ToString("n0")"
                                         Tone="neutral" />
                            <CompactStat Label="provide buffer"
                                         Value="@summary.BitswapProvideBufferLength.ToString("n0")"
                                         Tone="neutral" />
                            <CompactStat Label="duplicate blocks"
                                         Value="@summary.BitswapDuplicateBlocksReceived.ToString("n0")"
                                         Tone="warning" />
                            <CompactStat Label="duplicate data"
                                         Value="@FormatBytes(summary.BitswapDuplicateDataReceivedBytes)"
                                         Tone="warning" />
                        </CompactStatStrip>
                    </SectionCard>

                    <SectionCard Title="Connected peers" Description="Current swarm connections reported by the node.">
                        @if (summary.ConnectedPeers.Count == 0)
                        {
                            <EmptyState Eyebrow="Peers" Title="No active peer connections" Description="This node is online without an open swarm connection right now." />
                        }
                        else
                        {
                            <Stack Gap="0.75rem">
                                <div class="node-list">
                                    @foreach (var peer in summary.ConnectedPeers.Take(6))
                                    {
                                        <SelectionListItem Title="@Shorten(peer.Id, 34)"
                                                           Eyebrow="Connected peer"
                                                           Meta="@peer.Latency"
                                                           Summary="@peer.ConnectedAddress">
                                            <Status>
                                                <StatusBadge Text="@Shorten(peer.AgentVersion, 24)" Tone="success" />
                                            </Status>
                                        </SelectionListItem>
                                    }
                                </div>

                                @if (summary.ConnectedPeers.Count > 6)
                                {
                                    <Cluster Gap="LayoutGap.Small">
                                        <StatusBadge Text="@($"{summary.ConnectedPeers.Count - 6:n0} more peers")" Tone="info" />
                                    </Cluster>
                                }
                            </Stack>
                        }
                    </SectionCard>
                </Grid>
            </Stack>
        }
    </ChildContent>
</PageScaffold>

@code {
    private const string DashboardLoadErrorMessage = "Unable to load the node dashboard. Check the selected endpoint and try again.";

    private NodeSummarySnapshot? summary;
    private bool isLoading;
    private bool hasStartedInitialLoad;
    private bool isDisposed;
    private string? errorMessage;
    private CancellationTokenSource? loadCancellation;

    protected override void OnInitialized()
    {
        NodeSessionState.Changed += HandleNodeSessionChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !NodeSessionState.IsHydrated || hasStartedInitialLoad)
        {
            return Task.CompletedTask;
        }

        hasStartedInitialLoad = true;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (isDisposed)
        {
            return;
        }

        loadCancellation?.Cancel();
        var loadCancellationSource = new CancellationTokenSource();
        loadCancellation = loadCancellationSource;
        var cancellationToken = loadCancellationSource.Token;

        isLoading = true;
        errorMessage = null;
        Logger.LogInformation("Dashboard summary load started for target {BaseUrl}.", NodeSessionState.CurrentSettings.BaseUrl);

        try
        {
            var loadedSummary = await NodeDashboardService.GetSummaryAsync(cancellationToken);
            if (!ReferenceEquals(loadCancellation, loadCancellationSource) || isDisposed)
            {
                return;
            }

            summary = loadedSummary;
            Logger.LogInformation("Dashboard summary load completed for peer {PeerId}.", summary.PeerId);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            Logger.LogDebug("Dashboard summary load was canceled for target {BaseUrl}.", NodeSessionState.CurrentSettings.BaseUrl);
        }
        catch (Exception ex) when (!cancellationToken.IsCancellationRequested)
        {
            if (!ReferenceEquals(loadCancellation, loadCancellationSource) || isDisposed)
            {
                return;
            }

            summary = null;
            errorMessage = DashboardLoadErrorMessage;
            Logger.LogWarning(ex, "Dashboard summary load failed for target {BaseUrl}.", NodeSessionState.CurrentSettings.BaseUrl);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Dashboard load failed",
                Detail = DashboardLoadErrorMessage
            });
        }
        finally
        {
            var isCurrentLoad = ReferenceEquals(loadCancellation, loadCancellationSource);
            if (isCurrentLoad)
            {
                loadCancellation = null;
                isLoading = false;
            }

            loadCancellationSource.Dispose();

            if (isCurrentLoad && !isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleNodeSessionChanged()
    {
        if (!NodeSessionState.IsHydrated || isDisposed)
        {
            return;
        }

        hasStartedInitialLoad = true;
        _ = InvokeAsync(LoadAsync);
    }

    public void Dispose()
    {
        isDisposed = true;
        NodeSessionState.Changed -= HandleNodeSessionChanged;
        loadCancellation?.Cancel();
        loadCancellation = null;
    }

    private static string FormatBytes(ulong bytes)
        => FormatBytes((double)bytes);

    private static string FormatBytes(double bytes)
    {
        const double scale = 1024d;
        var value = Math.Max(0d, bytes);
        var units = new[] { "B", "KB", "MB", "GB", "TB" };
        var unit = 0;
        while (value >= scale && unit < units.Length - 1)
        {
            value /= scale;
            unit++;
        }

        return $"{value:n2} {units[unit]}";
    }

    private static string FormatRate(double bytesPerSecond)
        => $"{FormatBytes(bytesPerSecond)}/s";

    private static string FormatStorageUsage(NodeSummarySnapshot snapshot)
    {
        if (snapshot.RepoStorageMaxBytes == 0)
        {
            return "n/a";
        }

        var usage = snapshot.RepoSizeBytes * 100d / snapshot.RepoStorageMaxBytes;
        return $"{usage:n1}%";
    }

    private static string FormatTimestamp(DateTimeOffset timestamp)
        => timestamp.ToLocalTime().ToString("g");

    private static string Shorten(string value, int limit)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length <= limit)
        {
            return value;
        }

        return $"{value[..(limit - 3)]}...";
    }
}
