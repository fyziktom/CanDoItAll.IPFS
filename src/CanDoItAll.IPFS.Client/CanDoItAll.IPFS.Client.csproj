<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.IPFS.Client</AssemblyName>
    <RootNamespace>CanDoItAll.IPFS.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS0649</NoWarn>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <DebugType>portable</DebugType>

    <AssemblyVersion>0.42.0.0</AssemblyVersion>
    <Version>0.42.0</Version>

    <PackageId>CanDoItAll.IPFS.Client</PackageId>
    <Authors>Richard Schneider; CanDoItAll contributors</Authors>
    <Title>CanDoItAll IPFS Client</Title>
    <Description>A typed HTTP client for communicating with a CanDoItAll IPFS node.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/fyziktom/CanDoItAll.IPFS/releases</PackageReleaseNotes>
    <Copyright>Copyright (c) 2018 Richard Schneider and CanDoItAll contributors</Copyright>
    <PackageTags>ipfs peer-to-peer p2p distributed file-system web http client</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <PackageProjectUrl>https://github.com/fyziktom/CanDoItAll.IPFS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fyziktom/CanDoItAll.IPFS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.pdb;$(AllowedOutputExtensionsInPackageBuildOutputFolder)</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\package-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanDoItAll.IPFS.Engine\CanDoItAll.IPFS.Engine.csproj" />
  </ItemGroup>

</Project>
