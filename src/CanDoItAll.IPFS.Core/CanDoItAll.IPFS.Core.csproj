<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>CanDoItAll.IPFS.Core</AssemblyName>
    <RootNamespace>CanDoItAll.IPFS.Core</RootNamespace>
    <IsPackable>true</IsPackable>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>

    <AssemblyVersion>0.42.0.0</AssemblyVersion>
    <Version>0.42.0</Version>

    <PackageId>CanDoItAll.IPFS.Core</PackageId>
    <Authors>Richard Schneider; CanDoItAll contributors</Authors>
    <Title>CanDoItAll IPFS Core</Title>
    <Description>Protocol primitives, value types, codecs, and API contracts shared by CanDoItAll IPFS implementations.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/fyziktom/CanDoItAll.IPFS/releases</PackageReleaseNotes>
    <Copyright>Copyright (c) 2018 Richard Schneider and CanDoItAll contributors</Copyright>
    <PackageTags>ipfs peer-to-peer p2p distributed file-system protocol primitives contracts</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <RepositoryUrl>https://github.com/fyziktom/CanDoItAll.IPFS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.pdb;$(AllowedOutputExtensionsInPackageBuildOutputFolder)</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Common.Logging" Version="3.4.1" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="SimpleBase" Version="5.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\package-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
