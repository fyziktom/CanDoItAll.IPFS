# Copy to ignored .env for local development. These values are not production secrets.
COMPOSE_PROJECT_NAME=candoitall-ipfs
CDA_BIND_ADDRESS=127.0.0.1
NODE_CONTROL_PORT=5093
IPFS_NODE_API_PORT=5001

# Replace this placeholder only in the ignored .env file or current shell.
IPFS_PASS=replace-for-local-development

IPFS_NODE_IMAGE=candoitall-ipfs-node:dev
NODE_CONTROL_IMAGE=candoitall-ipfs-node-control:dev

IPFS_NODE_MEMORY_LIMIT=1g
IPFS_NODE_CPU_LIMIT=2.0
IPFS_NODE_PID_LIMIT=512

NODE_CONTROL_MEMORY_LIMIT=768m
NODE_CONTROL_CPU_LIMIT=1.5
NODE_CONTROL_PID_LIMIT=256
