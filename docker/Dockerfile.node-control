FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS build
WORKDIR /src

COPY . .
RUN dotnet restore src/CanDoItAll.IPFS.NodeControl/CanDoItAll.IPFS.NodeControl.csproj \
    -p:TargetFramework=net10.0 \
    --runtime linux-x64 \
    --configfile docker/NuGet.Docker.config
RUN dotnet publish src/CanDoItAll.IPFS.NodeControl/CanDoItAll.IPFS.NodeControl.csproj \
    --configuration Release \
    --framework net10.0 \
    --runtime linux-x64 \
    --self-contained false \
    --no-restore \
    -p:UseAppHost=false \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0.10 AS runtime
WORKDIR /app

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data/node-control/settings /data/node-control/remote-pin /data/node-control/logs /data/node-control/explorer-index \
    && chown -R "$APP_UID:$APP_UID" /app /data

COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Container \
    ASPNETCORE_URLS=http://+:8080

EXPOSE 8080
VOLUME ["/data/node-control"]

USER $APP_UID
ENTRYPOINT ["dotnet", "CanDoItAll.IPFS.NodeControl.dll"]
